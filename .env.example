# Meta Cloud API (leave blank until week 3)
WHATSAPP_VERIFY_TOKEN=dev-verify-token
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Laptop demo uses SQLite. Swap to Postgres when hosting.
DATABASE_URL=file:./data/wonderpath.db

# E.164 numbers, comma-separated (hers + parent)
ALLOWLIST_PHONES=+91XXXXXXXXXX,+91YYYYYYYYYY
PARENT_PIN=0000

TZ=Asia/Kolkata
PORT=3000
NODE_ENV=development
